/**
 * 8-way 16-bit multiplexor:
 * out = a if sel = 000
 *       b if sel = 001
 *       c if sel = 010
 *       d if sel = 011
 *       e if sel = 100
 *       f if sel = 101
 *       g if sel = 110
 *       h if sel = 111
 */
CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

    PARTS:
    Mux16(a= a, b= b, sel= sel[0], out= wa);
    Mux16(a= c, b= d, sel= sel[0], out= wb);

    Mux16(a= e, b= f, sel= sel[0], out= wc);
    Mux16(a= g, b= h, sel= sel[0], out= wd);
    
    
    Mux16(a= wa, b= wb, sel= sel[1], out= wouta);
    Mux16(a= wc, b= wd, sel= sel[1], out= woutb);
    
    Mux16(a= wouta, b= woutb, sel= sel[2], out= out);
}
